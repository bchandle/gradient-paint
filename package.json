{
  "name": "gradient-paint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time gradient-domain painting in the browser, with a WebGPU multigrid integrator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:gpu && npm run test:e2e",
    "test:unit": "vitest run",
    "test:gpu": "node scripts/run-gpu-tests.mjs",
    "test:e2e": "node tests/e2e/touch.e2e.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
